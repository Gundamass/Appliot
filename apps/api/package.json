{
  "name": "@resume/api",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ../../tsconfig.json",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/server.js --external:@napi-rs/canvas --external:better-sqlite3 --external:drizzle-orm --external:drizzle-orm/* --external:fastify --external:@fastify/* --external:pdfjs-dist/* && esbuild ../browser-worker/src/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/browser-worker.js --external:playwright-core",
    "start": "node --env-file-if-exists=../../.env.local dist/server.js",
    "dev": "node --env-file-if-exists=../../.env.local --import tsx src/server.ts"
  },
  "dependencies": {
    "@fastify/busboy": "3.2.0",
    "@fastify/multipart": "9.2.1",
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.12",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@napi-rs/canvas": "0.1.70",
    "@resume/action-policy": "workspace:*",
    "@resume/contracts": "workspace:*",
    "@resume/form-semantics": "workspace:*",
    "@resume/job-matching": "workspace:*",
    "@resume/model-provider": "workspace:*",
    "@resume/profile-domain": "workspace:*",
    "@resume/rag": "workspace:*",
    "better-sqlite3": "11.10.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.3",
    "langsmith": "0.9.0",
    "pdfjs-dist": "5.3.31",
    "playwright-core": "1.53.1",
    "xstate": "5.19.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "esbuild": "0.28.1"
  }
}
