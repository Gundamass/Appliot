index 0000000000000000000000000000000000000000..87c3889d543dbec0085217d27465bd2c7873cdbc
--- /dev/null
+++ b/scripts/resume-native-build.cjs
@@ -0,0 +1,40 @@
+const { existsSync, readFileSync } = require("node:fs");
+const path = require("node:path");
+
+function isWorkspaceRoot(directory, { paths, exists, readFile }) {
+  const workspaceFile = paths.join(directory, "pnpm-workspace.yaml");
+  const packageFile = paths.join(directory, "package.json");
+  if (!exists(workspaceFile) || !exists(packageFile)) return false;
+
+  try {
+    return JSON.parse(readFile(packageFile, "utf8")).name === "resume-application-assistant";
+  } catch {
+    return false;
+  }
+}
+
+function findWorkspaceRoot(startDirectory, { paths = path, exists = existsSync, readFile = readFileSync } = {}) {
+  let directory = paths.resolve(startDirectory);
+  while (true) {
+    if (isWorkspaceRoot(directory, { paths, exists, readFile })) return directory;
+    const parent = paths.dirname(directory);
+    if (parent === directory) {
+      throw new Error("could not find the resume-application-assistant workspace root");
+    }
+    directory = parent;
+  }
+}
+
+function runBootstrap({ startDirectory = process.cwd(), loadWrapper = require } = {}) {
+  const packageDirectory = path.resolve(startDirectory);
+  const repositoryRoot = findWorkspaceRoot(packageDirectory);
+  const wrapperPath = path.join(repositoryRoot, "scripts", "native-build-wrapper.cjs");
+  const { runNativeBuild } = loadWrapper(wrapperPath);
+  return runNativeBuild({ repositoryRoot, packageDirectory });
+}
+
+module.exports = { findWorkspaceRoot, runBootstrap };
+
+if (require.main === module) {
+  process.exitCode = runBootstrap();
+}
