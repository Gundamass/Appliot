{
  "name": "resume-application-assistant",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "test": "corepack pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "node scripts/run-playwright.mjs test",
    "typecheck": "tsc --noEmit",
    "build": "corepack pnpm -r build",
    "eval:agent": "tsx evals/agent/run-evals.ts",
    "start:api": "corepack pnpm --filter @resume/api start",
    "start:web": "node scripts/serve-web.mjs",
    "services:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service-control.ps1 status",
    "services:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service-control.ps1 start",
    "services:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/service-control.ps1 stop"
  },
  "devDependencies": {
    "@playwright/test": "1.53.1",
    "@types/node": "24.0.0",
    "node-gyp": "12.1.0",
    "pdf-lib": "1.17.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "node-gyp": "12.1.0"
    },
    "patchedDependencies": {
      "better-sqlite3@11.10.0": "patches/better-sqlite3@11.10.0.patch"
    }
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.62.2"
  }
}
