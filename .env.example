# This file is safe to copy to .env.local. Keep optional groups commented out
# until the matching local or remote service is ready.

# Local API and SQLite storage
DATABASE_FILE=data/resume-assistant.sqlite
API_PORT=43120

# Optional: DeepSeek structured review and ATS adapter review.
# Uncomment the complete group and set DEEPSEEK_API_KEY to enable it.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_DEFAULT=deepseek-v4-flash
# DEEPSEEK_MODEL_ESCALATION=deepseek-v4-pro
# DEEPSEEK_THINKING=disabled
# DEEPSEEK_TIMEOUT_MS=60000
# DEEPSEEK_MAX_RETRIES=2

# Optional: loopback tunnel to the pinned embedding worker.
# EMBEDDING_BASE_URL=http://127.0.0.1:18080
# EMBEDDING_API_TOKEN=
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# EMBEDDING_MODEL_REVISION=1d8ad4ca9b3dd8059ad90a75d4983776a23d44af
# EMBEDDING_DIMENSIONS=4096
# EMBEDDING_TIMEOUT_MS=60000

# Optional: loopback tunnel to the pinned OCR worker.
# OCR_BASE_URL=http://127.0.0.1:43121
# OCR_API_TOKEN=
# OCR_MODEL=deepseek-ai/DeepSeek-OCR-2
# OCR_MODEL_REVISION=aaa02f3811945a91062062994c5c4a3f4c0af2b0
# OCR_TIMEOUT_MS=180000

# Debug retention for encrypted raw ATS adapter model responses is deliberately
# omitted. See docs/ats-adapter-certification.md before enabling it.
