# Runtime paths are fixed for the remote heqing account.
RESUME_AI_ROOT=/home/heqing/resume-ai

# Worker identity and listeners are pinned and must remain loopback-only.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_MODEL_REVISION=1d8ad4ca9b3dd8059ad90a75d4983776a23d44af
EMBEDDING_DIMENSIONS=4096
EMBEDDING_HOST=127.0.0.1
EMBEDDING_PORT=18080
OCR_MODEL=deepseek-ai/DeepSeek-OCR-2
OCR_MODEL_REVISION=aaa02f3811945a91062062994c5c4a3f4c0af2b0
OCR_HOST=127.0.0.1
OCR_PORT=43121

# Tokens are generated by install.sh. Store only their paths here.
EMBEDDING_API_TOKEN_FILE=/home/heqing/resume-ai/run/embedding.token
OCR_API_TOKEN_FILE=/home/heqing/resume-ai/run/ocr.token
